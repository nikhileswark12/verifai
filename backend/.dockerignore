# ======================================================
# .dockerignore — files excluded from the Docker build context
# ======================================================

# Virtual environments
venv/
.venv/
env/
.env/

# Secrets — NEVER bake .env into the image
.env
*.env
!.env.example

# Python cache / compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Tests (not needed at runtime)
tests/

# Development and editor metadata
.git/
.gitignore
.gitattributes
*.md
!README.md

# IDE / OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# CI / Docker itself (no recursion)
Dockerfile
.dockerignore
docker-compose*.yml
