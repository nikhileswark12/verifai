# VerifAI Backend — Environment Variables
# =========================================
# Copy this file to .env and fill in real values.
# Never commit the real .env file to version control.
#
# In production: set these as container/host environment variables instead.

# ── Required secrets (no default — app will refuse to start without these) ──
OPENROUTER_API_KEY=your_openrouter_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# ── CORS (comma-separated list of allowed frontend origins) ─────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── LLM Provider (OpenRouter) ────────────────────────────────────────────────
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1:free

# ── Optional settings (defaults shown) ──────────────────────────────────────
DEBUG=false
MAX_TOKENS=4096
TEMPERATURE=0.0
REQUEST_TIMEOUT=60
MAX_RETRIES=2
LOG_LEVEL=INFO
PIPELINE_TIMEOUT_SECONDS=90
SEARCH_RETRY_COUNT=1
MIN_SOURCES_FOR_VERIFIED=2
